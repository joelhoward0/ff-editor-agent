{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check_prose.py\"",
            "timeout": 20,
            "statusMessage": "Checking prose…"
          }
        ]
      }
    ]
  }
}
